# Rizz Edits Studio API — environment template.
# Copy to `.env` and fill in real values. Never commit a filled `.env`.

# Database. SQLite file by default (zero setup). For production use Postgres:
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/rizz_studio
DATABASE_URL=sqlite:///./rizz_studio.db

# CORS: comma-separated origins allowed to call the API from a browser.
# Example: ALLOWED_ORIGINS=https://rizzedits.com,https://www.rizzedits.com
# Use "*" only for local development, never in production.
ALLOWED_ORIGINS=

# Simple shared-secret protection for the admin list endpoint.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# Email notifications for new inquiries. Pick ONE provider (Resend is easiest on
# free hosts like Render, where outbound SMTP ports are blocked).
# Option A — Resend (HTTPS API, free tier): sign up at resend.com, create an
# API key, and set it here. Verify your domain in Resend for production, or
# keep the default onboarding sender for testing.
RESEND_API_KEY=
RESEND_FROM=
# Option B — SMTP (VPS / paid hosts only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_TO=

# Max inquiry submissions per IP per minute.
RATE_LIMIT_PER_MINUTE=20
